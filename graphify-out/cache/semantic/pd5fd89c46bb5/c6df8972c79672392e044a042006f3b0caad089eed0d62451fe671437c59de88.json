{"nodes": [{"id": "docs_animation_fluidity_audit_animation_fluidity_audit", "label": "Fighter Animation Fluidity Audit (2026-10-03)", "file_type": "document", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_animation_fluidity_audit_render_interpolation", "label": "RenderInterpolation (continuous root motion)", "file_type": "rationale", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Originally stopped at every state change and throughout attacks, causing discontinuities; now preserves root motion across safe idle/walk/jump/fall transitions and same-move windup/recovery, while impact, beams, dives, grapples and landing stay position-exact. Bounded to one 60 Hz tick of delay."}, {"id": "docs_animation_fluidity_audit_visual_registry", "label": "VisualRegistry (sprite factories and adapters)", "file_type": "concept", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_animation_fluidity_audit_texture_cache", "label": "TextureCache", "file_type": "concept", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_animation_fluidity_audit_simulation_based_cosmetic_time", "label": "Simulation-based Cosmetic Time", "file_type": "rationale", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cosmetic motion (Dodo playing loop, Astolfo breathing, Jomp/Fausto auras) used wall-clock time and kept advancing during pause/hit-stop; SceneRenderer now supplies simulation-based time to fighters and summons while stage effects keep their own clock."}, {"id": "docs_animation_fluidity_audit_fractional_clocks_weakmap", "label": "Fractional Clocks in WeakMap", "file_type": "rationale", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional fractional clocks are keyed only by disposable display copies so integer simulation clocks and pose selection stay untouched; subtle weight shifts render between ticks without extra art."}, {"id": "docs_animation_fluidity_audit_sprite_clip_per_frame_holds", "label": "SpriteClip Per-frame Holds", "file_type": "concept", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_animation_fluidity_audit_authored_walk", "label": "AuthoredWalk", "file_type": "concept", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_animation_fluidity_audit_walk_timing_review", "label": "Per-fighter Walk Timing Review", "file_type": "rationale", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walk rates differ intentionally per fighter (4-8 poses, 5-8 ticks/pose); blanket FPS increases would rush heavy poses without adding artwork, so existing rates were preserved."}, {"id": "docs_animation_fluidity_audit_animation_review_page", "label": "Animation Review Page (dev-only)", "file_type": "concept", "source_file": "docs/animation-fluidity-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_animation_fluidity_audit_rollback_manager", "label": "RollbackManager", "file_type": "concept", "source_file": "docs/animation-flui