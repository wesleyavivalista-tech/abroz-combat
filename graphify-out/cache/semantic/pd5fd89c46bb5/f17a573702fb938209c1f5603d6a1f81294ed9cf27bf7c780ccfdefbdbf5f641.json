{"nodes": [{"id": "docs_sprite_isolation_sprite_isolation", "label": "SpriteIsolation (pose ownership masks)", "file_type": "rationale", "source_file": "docs/SPRITE-ISOLATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pose rectangles on shared sheets included neighboring artwork, but tightening them would cut hands, feet, flames or beard attacks; the renderer instead labels connected artwork by owning pose and discards neighbors, keeping frame sizes, pivots and timing unchanged. Masks cached per sheet."}, {"id": "docs_sprite_isolation_source_alpha_audit", "label": "Source-alpha Contamination Audit", "file_type": "concept", "source_file": "docs/SPRITE-ISOLATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_sprite_isolation_sprite_isolation", "target": "docs_sprite_isolation_source_alpha_audit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPRITE-ISOLATION.md", "source_location": null, "weight": 1.0}, {"source": "docs_sprite_isolation_sprite_isolation", "target": "docs_bozo_bozo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPRITE-ISOLATION.md", "source_location": null, "weight": 1.0}, {"source": "docs_sprite_isolation_sprite_isolation", "target": "docs_tocha_tocha", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPRITE-ISOLATION.md", "source_location": null, "weight": 1.0}], "hyperedges": []}