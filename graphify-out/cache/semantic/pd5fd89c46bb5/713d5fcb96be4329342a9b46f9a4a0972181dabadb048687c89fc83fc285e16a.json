{"nodes": [{"id": "docs_controller_support_report_controller_support_report", "label": "Controller Support Report (2026-10-03)", "file_type": "document", "source_file": "docs/controller-support-report.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_controller_support_report_input_pipeline", "label": "Controller input pipeline (device -> slot -> Button mask -> InputBuffer)", "file_type": "rationale", "source_file": "docs/controller-support-report.txt", "source_location": "2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Physical devices map to explicitly assigned local players producing the existing Button bitmask, so simulation, rollback and protocol code remained unchanged."}, {"id": "docs_controller_support_report_session_device_key_assignment", "label": "Session device key slot assignment", "file_type": "rationale", "source_file": "docs/controller-support-report.txt", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser gamepad indices and IDs are not stable hardware identities, so slots store per-connection session keys; one pad occupies exactly one slot, disconnected slots stay reserved, nothing persists across refresh."}, {"id": "docs_controller_support_report_default_controller_mapping", "label": "Default controller mapping", "file_type": "concept", "source_file": "docs/controller-support-report.txt", "source_location": "6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_controller_support_report_keyboard_coexistence", "label": "Keyboard coexistence and seat reservation", "file_type": "rationale", "source_file": "docs/controller-support-report.txt", "source_location": "7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both original keyboard layouts stay active for P1/P2; using a layout reserves its seat so the first pad joins the next free seat."}, {"id": "docs_controller_support_report_press_any_button_to_join", "label": "Press any button to join", "file_type": "rationale", "source_file": "docs/controller-support-report.txt", "source_location": "9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fresh button on an unassigned standard-mapped pad claims a disconnected reserved slot first, then the next free seat; the join press is consumed and movement alone does not join."}, {"id": "docs_controller_support_report_disconnect_reconnect_policy", "label": "Disconnect/reconnect policy", "file_type": "rationale", "source_file": "docs/controller-support-report.txt", "source_location": "14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical controller IDs are not reliable serials, so reconnect is an explicit press-based claim; local disconnect pauses, online disconnect only releases local input since the shared simulation cannot pause."}, {"id": "docs_controller_support_report_menu_ownership_lease", "label": "Menu ownership lease (500ms)", "file_type": "rationale", "source_file": "docs/controller-support-report.txt", "source_location": "14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arbitrates simultaneous pads in general menus; sequential 1v1 selection restricts to current player's pad and pause menu belongs to the pausing controller."}, {"id": "docs_controller_support_report_standard_mapping_only", "label": "Standard mapping only for gameplay", "file_type": "rationale", "source_file": "docs/controller-support-report.txt", "source_location": "16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nonstandard devices remain visible and testable but cannot feed gameplay so they never trigger wrong attacks."}, {"id": "docs_controller_support_report_controller_review_harness", "label": "controller-review.html harness", "file_type": "concept", "source_file": "docs/controller-support-report.txt", "source_location": "17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_controller_support_report_max_local_gamepads", "label": "MAX_LOCAL_GAMEPADS (8 slots)", "file_type": "concept", "source_file": "docs/controller-support-report.txt", "source_location": "8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_input_gamepadmanager_gamepadmanager", "label": "GamepadManager", "file_type": "code", "source_file": "docs/controller-support-report.txt", "source_location": "apps/client/src/input/GamepadManager.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_input_menunavigation_menunavigation", "label": "MenuNavigation", "file_type": "code", "source_file": "docs/controller-support-report.txt", "source_location": "apps/client/src/input/MenuNavigation.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_input_inputmanager_inputmanager", "label": "InputManager", "file_type": "code", "source_file": "docs/controller-support-report.txt", "source_location": "apps/client/src/input/InputManager.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_ui_controllers", "label": "ui/Controllers.ts", "file_type": "code", "source_file": "docs/controller-support-report.txt", "source_location": "apps/client/src/ui/Controllers.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_main", "label": "apps/client/src/main.ts", "file_type": "code", "source_file": "docs/controller-support-report.txt", "source_location": "apps/client/src/main.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_cont