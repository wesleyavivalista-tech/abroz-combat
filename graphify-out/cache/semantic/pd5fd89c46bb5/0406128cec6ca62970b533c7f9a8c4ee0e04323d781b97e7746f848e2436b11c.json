{"nodes": [{"id": "docs_desktop_architecture_audit_pre_implementation_audit", "label": "Desktop Pre-Implementation Audit (2026-10-05)", "file_type": "document", "source_file": "docs/desktop/architecture-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_desktop_architecture_audit_electron_decision", "label": "Electron over Tauri decision", "file_type": "rationale", "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundled Chromium gives consistent WebGL, Canvas readback, eight-controller Gamepad API and Web Audio behavior; Tauri's system WebView2/WKWebView/WebKitGTK would add a compatibility matrix. Assets already dominate size so Electron's runtime overhead is acceptable."}, {"id": "docs_desktop_architecture_audit_tauri_alternative", "label": "Tauri (rejected alternative)", "file_type": "concept", "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_desktop_architecture_audit_abroz_game_origin", "label": "abroz://game secure origin", "file_type": "rationale", "source_file": "docs/desktop/architecture-audit.txt", "source_location": "fetch", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Root-relative /art and /audio fetches would break under file://, so the packaged client is served from a standard secure custom origin via a constrained protocol handler without a local HTTP server."}, {"id": "docs_desktop_architecture_audit_browser_api_inventory", "label": "Browser API inventory for desktop", "file_type": "concept", "source_file": "docs/desktop/architecture-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_desktop_architecture_audit_wss_endpoint_requirement", "label": "Configured WSS endpoint or explicit offline mode", "file_type": "rationale", "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Multiplayer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packaged builds cannot infer ws://game:8080 from the page host; the relay stays separately deployed and builds must set VITE_WS_URL or declare offline mode."}, {"id": "docs_desktop_architecture_audit_allowed_origins_policy", "label": "ALLOWED_ORIGINS must include abroz://game", "file_type": "rationale", "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Multiplayer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server origin checks stay exact; the desktop origin is added explicitly, never wildcarded or bypassed."}, {"id": "docs_desktop_architecture_audit_offline_font_bundling", "label": "Offline Barlow font bundling", "file_type": "rationale", "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Fonts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Google Fonts CSS import was an online dependency; licensed same-family font files are bundled so the desktop build works offline."}, {"id": "docs_desktop_architecture_audit_safe_storage_service", "label": "Narrow safe storage service", "file_type": "rationale", "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Storage", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only afterglow-controls and abroz-audio-v1 localStorage keys exist; a guarded service keeps identical keys/schema while tolerating unreadable storage."}, {"id": "docs_desktop_architecture_audit_fullscreen_bridge", "label": "Minimal validated fullscreen IPC", "file_type": "rationale", "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Fullscreen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the single DOM fullscreen call in main.ts is replaced; the desktop bridge exposes fullscreen toggle only and validates the main-frame sender."}], "edges": [{"source": "docs_desktop_architecture_audit_pre_implementation_audit", "target": "docs_desktop_architecture_audit_electron_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Decision", "weight": 1.0}, {"source": "docs_desktop_architecture_audit_electron_decision", "target": "docs_desktop_architecture_audit_tauri_alternative", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Decision", "weight": 1.0}, {"source": "docs_desktop_architecture_audit_browser_api_inventory", "target": "docs_desktop_architecture_audit_electron_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/desktop/architecture-audit.txt", "source_location": null, "weight": 1.0}, {"source": "docs_desktop_architecture_audit_browser_api_inventory", "target": "apps_client_src_input_gamepadmanager_gamepadmanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Gamepad", "weight": 1.0}, {"source": "docs_desktop_architecture_audit_abroz_game_origin", "target": "docs_desktop_architecture_audit_allowed_origins_policy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/desktop/architecture-audit.txt", "source_location": "Multiplayer", "weight": 1.0}, {"source": "docs_desktop_architecture_audit_allowed_origins_policy", "target": "apps_server_src_rooms_expireinactive", "relation": "conceptually_related_to", "confiden