{"nodes": [{"id": "docs_audio_audit_audio_audit", "label": "Audio Audit and Implementation (2026-10-03)", "file_type": "document", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_audio_audiomanager_audiomanager", "label": "AudioManager", "file_type": "code", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_audio_audiopolicy_audiopolicy", "label": "AudioPolicy", "file_type": "code", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_audio_soundregistry_soundregistry", "label": "SoundRegistry", "file_type": "code", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_audio_musicregistry_musicregistry", "label": "MusicRegistry", "file_type": "code", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_audio_gameaudio_gameaudio", "label": "GameAudio", "file_type": "code", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audio_audit_bus_graph", "label": "Audio Bus Graph (Master, Music, SFX, Voice, Critical)", "file_type": "rationale", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Master feeds a gentle compressor; critical combat (KO/ultimate) has a separate path under SFX so combat ducking does not duck the KO; previously gains were baked into each note so live volume changes did nothing."}, {"id": "docs_audio_audit_music_routing_states", "label": "Music Routing States", "file_type": "rationale", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selection priority: arena exact-state override, global state/mode track, arena pool, theme-profile pool, default battle track. Sudden-death is a hook with no simulation mechanic. Final intensity when at most two fighters remain with one life each; training excluded."}, {"id": "docs_audio_audit_voice_admission_limits", "label": "Voice Admission Limits (24 SFX, cooldowns, dedup)", "file_type": "concept", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audio_audit_presentation_boundary_playback", "label": "Presentation-boundary Audio Playback", "file_type": "rationale", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GameAudio runs only at the client presentation boundary after tick(), never inside rollback replay, with bounded event-id suppression. Predicted sounds cannot be undone; confirmed-only playback would add latency, so responsive playback is kept while replay bursts are prevented. Audio never gates gameplay or sends network messages."}, {"id": "docs_audio_audit_missing_asset_report", "label": "Missing Audio Asset Report", "file_type": "concept", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audio_audit_abroz_audio_v1_storage", "label": "abroz-audio-v1 Settings Storage", "file_type": "concept", "source_file": "docs/audio-audit.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audio_audit_audio_review_page",