{
  "name": "afterglow-foundation",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "dev:server": "tsx apps/server/src/index.ts",
    "build": "npm run typecheck && vite build --config apps/client/vite.config.ts && tsc -p apps/server/tsconfig.json",
    "start:server": "node dist-server/apps/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test --import ./tests/setup/english-locale.mjs tests/*.test.ts",
    "test:coverage": "tsx --test --import ./tests/setup/english-locale.mjs --experimental-test-coverage --test-coverage-include=packages/** --test-coverage-include=apps/** tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test:desktop && npm run test:deployment && npm run test:e2e",
    "check": "npm run typecheck && npm run lint && npm test",
    "postinstall": "node scripts/graphify-setup.mjs --from-install",
    "graphify:setup": "node scripts/graphify-setup.mjs --strict",
    "graphify:update": "node scripts/graphify-setup.mjs --update",
    "predev": "node scripts/simulation-revision.mjs",
    "predev:client": "node scripts/simulation-revision.mjs",
    "predev:server": "node scripts/simulation-revision.mjs",
    "prebuild": "node scripts/simulation-revision.mjs",
    "precheck": "node scripts/simulation-revision.mjs",
    "build:web": "node scripts/simulation-revision.mjs && tsc --noEmit && vite build --config apps/client/vite.config.ts",
    "dev:desktop": "node scripts/desktop.mjs dev",
    "start:desktop": "node scripts/desktop.mjs run",
    "build:desktop": "node scripts/desktop.mjs build",
    "desktop:install-runtime": "node node_modules/electron/install.js",
    "test:desktop": "node --test tests/desktop-*.test.mjs",
    "test:deployment": "node --test tests/deployment-config.test.mjs tests/compatibility-metadata.test.mjs tests/deploy-server-safe.test.mjs",
    "release:configure": "node scripts/release-config.mjs",
    "release:web": "node scripts/build-release-web.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
